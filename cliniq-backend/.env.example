
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3-4b-nothink
# Changing the embedding model requires re-uploading documents
OLLAMA_EMBED_MODEL=hf.co/Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0

# Chroma server; leave CHROMA_HOST unset to use the embedded store in CHROMA_PERSIST_DIR
CHROMA_HOST=localhost
CHROMA_PORT=8100
OPENAI_API_KEY=your_openai_api_key_here
